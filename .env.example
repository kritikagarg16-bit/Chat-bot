# ─── Groq API ───────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── Model (pick one) ────────────────────────────────────────────────────────
# llama-3.3-70b-versatile   ← best quality (default)
# llama-3.1-8b-instant      ← fastest
# mixtral-8x7b-32768        ← great for long context
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Personality ─────────────────────────────────────────────────────────────
# Customize your bot's personality here!
BOT_PERSONA=You are a helpful, friendly, and smart AI assistant. Be concise, warm, and engaging in your responses.

# ─── Tuning ──────────────────────────────────────────────────────────────────
TEMPERATURE=0.7
MAX_TOKENS=1024
